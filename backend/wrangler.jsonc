{
  // Cloudflare Worker. Hisob ID va D1 database_id ni egasi o'z hisobidan qo'yadi (maxfiy emas, lekin shaxsiy).
  "name": "samiya-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    // PUBLIC_LAUNCH_DATE ni FAQAT rasmiy ommaviy launch kuni egasi qo'yadi (YYYY-MM-DD). Hozir bo'sh = prelaunch.
    "CAMPAIGN_DURATION_DAYS": "90",
    "AI_FREE_DAILY_REQUESTS": "3",
    "AI_CAMPAIGN_DAILY_REQUESTS": "10",
    "AI_PRO_DAILY_REQUESTS": "50",
    "AI_MODEL": "gemini-2.5-flash-lite",
    "BILLING_ENABLED": "false",
    "ADS_ENABLED": "false",
    "FIREBASE_PROJECT_ID": "samiya-beauty-lab",
    "ADMIN_EMAILS": "davlatsudekspert@gmail.com"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "samiya", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ]
  // FIREBASE_PROJECT_ID maxfiy emas (ommaviy loyiha ID). Maxfiylar (GEMINI_API_KEY, REVENUECAT_WEBHOOK_SECRET...) faqat `wrangler secret put` orqali.
}
